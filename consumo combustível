# Lê a distância percorrida e o combustível gasto
quilometros = float(input("Digite a quantidade de quilômetros percorridos (km): "))
litros = float(input("Digite a quantidade de litros utilizados (L): "))

# Verifica se os litros são maiores que zero para evitar divisão por zero
if litros > 0:
    consumo_medio = quilometros / litros
    print(f"O consumo médio do veículo é de: {consumo_medio:.2f} km/l")
else:
    print("Erro: A quantidade de litros deve ser maior que zero.")