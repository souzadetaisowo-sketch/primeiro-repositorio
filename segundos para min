segundos_totais = int(input("Digite a quantidade total de segundos: "))

# Calcula a quantidade de minutos cheios
minutos = segundos_totais // 60

# Calcula o resto dos segundos que sobraram
segundos_restantes = segundos_totais % 60

# Exibe o resultado final formatado
print(f"{segundos_totais} segundos equivalem a: {minutos} min e {segundos_restantes} seg.")